# Copy to .env if it does not exist, then replace the placeholder secrets.
# Single-quote secrets containing $NAME for Compose; avoid ${NAME} in literal secrets,
# because python-dotenv expands that syntax even inside single quotes.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

JWT_SECRET_KEY=replace-with-another-long-random-secret
ALGORITHMS=HS256
TG_BOT_AUTH_KEY=replace-with-a-bot-api-key

# The API starts without live Yandex credentials, but translation suggestions need them.
YANDEX_CLOUD_FOLDER=replace-with-your-folder-id
YANDEX_CLOUD_API_KEY=replace-with-your-yandex-api-key
YANDEX_CLOUD_MODEL=replace-with-your-model-name

# Docker Compose overrides DB_HOST and CELERY_BROKER_URL with service addresses.
DB_NAME=german_db
DB_USER=postgres
DB_PASSWORD=replace-with-a-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
CELERY_BROKER_URL=redis://localhost:6379/0
